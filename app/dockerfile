# Build Stage
FROM golang:1.26.2-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o grafan-lxd-monitoring .

# Final Stage
FROM alpine:latest
RUN apk add --no-cache ca-certificates && adduser -D -u 10001 app
USER app
WORKDIR /home/app
COPY --from=builder /app/grafan-lxd-monitoring .
EXPOSE 8080
CMD ["./grafan-lxd-monitoring"]